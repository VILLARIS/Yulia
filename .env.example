# Aplicación
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
API_PORT=3001
VITE_API_URL=http://localhost:3001/api

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bioquimica_nutricional
DATABASE_SSL=false

# Autenticación (reemplace con un secreto largo y aleatorio)
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h

# OpenAI (solo backend)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Grabaciones autorizadas
RECORDINGS_ENABLED=false
RECORDINGS_STORAGE_PATH=./uploads/recordings
RECORDINGS_RETENTION_DAYS=30

# Conservación general
ACADEMIC_RECORDS_RETENTION_DAYS=730
SUPERVISION_EVENTS_RETENTION_DAYS=180

