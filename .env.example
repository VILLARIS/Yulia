# Copie este archivo a apps/api/.env
# Aplicación
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
API_PORT=3001

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bioquimica_nutricional
DATABASE_SSL=false

# Autenticación (reemplace con un secreto largo y aleatorio)
JWT_SECRET=replace-with-at-least-32-random-characters

# Modelo de texto usado con la API key temporal de cada estudiante
GEMINI_MODEL=gemini-3.5-flash-lite

# Supabase Storage para las portadas de los cursos (solo backend)
# Cree un bucket público llamado course-covers sin políticas de escritura pública.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=course-covers
